<?xml version="1.0" encoding="UTF-8"?>
<!-- Read only when log4j-core starts: when log-level asks for WARN or more.
     Otherwise the run uses the Log4j API's simple logger, and diagnostics
     reach stderr without a logger (LoggingBootstrap, #216). -->
<Configuration status="OFF">
  <Appenders>
    <Console name="Console" target="SYSTEM_ERR">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %logger{1} - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <!-- The log-level option sets this logger's level. -->
    <Logger name="ca.mcscert.jpipe" level="error" additivity="false">
      <AppenderRef ref="Console"/>
    </Logger>
    <Root level="off">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
