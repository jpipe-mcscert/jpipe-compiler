#!/bin/sh
set -e

case "$1" in
    configure)
        JAVA_BIN=$(dpkg-query -L openjdk-25-jre-headless | grep '/bin/java$' | head -1)
        if [ -z "$JAVA_BIN" ] || [ ! -x "$JAVA_BIN" ]; then
            echo "jpipe: could not locate Java 25 binary from openjdk-25-jre-headless" >&2
            exit 1
        fi
        sed -i "s|which java > /dev/null|test -x '${JAVA_BIN}'|g" /usr/bin/jpipe
        sed -i "s|@@JAVA@@|${JAVA_BIN}|g" /usr/bin/jpipe
        # Faster start-up for every call, made on this machine because the
        # cache only works for the Java build that created it (#216). Without
        # it jPipe still runs, so a failure does not fail the install.
        /usr/bin/jpipe --create-aot-cache || true
        ;;
esac

#DEBHELPER#
