/*********************************
 * jPipe  -  Reference Examples  *
 * @author   Sebastien Mosser    *
 * @compiler 3.x                 *
 *********************************/

// Each failing operator call is reported at the call, naming the operator.
justification a {
    conclusion c is "C"
    strategy   s is "S"
    evidence   e is "E"
    s supports c
    e supports s
}

// line 17: 'typo' is no model
justification r is refine(a, typo) {
    hook: "e"
}

// line 22: there is no such operator
justification z is frobnicate(a)

// line 26: uses 'z', which the failed call above never built. That failure is
// already reported: this call adds no error of its own.
justification w is refine(z, a) {
    hook: "e"
}
