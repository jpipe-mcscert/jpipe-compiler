// Strings are written between double quotes only: a single-quoted label is a
// syntax error, reported where it starts.
justification j {
    conclusion c is 'A conclusion'
    strategy   s is "A strategy"
    evidence   e is "An evidence"
    s supports c
    e supports s
}
